include README.md pyproject.toml uv.lock .python-version run.bat
include direction-approved.md
prune design/reviews
recursive-include design/approved *.png
recursive-include docs *.md *.json
recursive-include config/examples *.toml *.json *.md
recursive-include examples *.py *.md
recursive-include scripts *.py *.ps1
recursive-include tests *.py *.json
recursive-include src/lab_control/ui/styles *.qss
include src/lab_control/py.typed
recursive-include src/lab_control/instruments/devices *.md *.json
include deployment/components.json deployment/labcontrol.spec deployment/entry.py
include deployment/payload-migration.json
prune deployment/packages
include deployment/packages/manifest.json deployment/packages/README.md
include deployment/packages/python/requirements.txt
recursive-include deployment/packages README.md Terms_of_use.pdf EUPL-EN.pdf
