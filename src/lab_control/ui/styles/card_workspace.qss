/* Approved 0ae6721 MainWindow / DeviceCard appearance. One runtime theme. */
QWidget { color: #e7e9e8; background: #0b0d0f; font-size: 13px; }
QLabel { background: transparent; }
QLabel#pageTitle { color: #e9ebea; font-size: 26px; font-weight: 700; }
QLabel#pageDescription { color: #879296; font-size: 12px; }
QLabel#eyebrow { color: #e3a252; font-size: 10px; }
QLabel#overviewNote { color: #7f8b8e; font-size: 10px; }
QLabel#panelTitle { color: #e0e5e3; font-weight: 700; }

QPushButton {
    background: #1a1e20; border: 1px solid #485054; border-radius: 3px;
    color: #dfe3e1; padding: 5px 12px; min-height: 25px;
}
QPushButton:hover { background: #262b2d; border-color: #a87946; }
QPushButton:pressed { background: #34302b; }
QPushButton:disabled { color: #788286; background: #15191b; border-color: #303739; }
QPushButton#primaryButton { background: #d99342; border-color: #d99342; color: #14110d; font-weight: 700; min-height: 0; }
QPushButton#primaryButton:hover { background: #e9aa5a; }
QPushButton#primaryButton:disabled { background: #584832; color: #c5b9a8; }

QFrame#workspaceSidebar { background: #121416; border-right: 1px solid #2a3032; }
QLabel#commandBrand { font-size: 19px; font-weight: 700; color: #e9ebea; }
QLabel#commandEyebrow, QLabel#sidebarSection { color: #879296; font-size: 10px; }
QLabel#sidebarSection { margin-left: 7px; }
QPushButton#workspaceNav { text-align: left; color: #a5acad; border: 0; border-left: 2px solid transparent; padding: 9px 10px; min-height: 18px; background: transparent; }
QPushButton#workspaceNav:hover { background: #1d2123; color: #f0f1ef; }
QPushButton#workspaceNav:checked { color: #e3a252; background: #242628; border-left-color: #e3a252; font-weight: 700; }
QLabel#modeBadge { background: #201c17; border: 1px solid #705333; border-radius: 3px; color: #e3a252; padding: 7px 8px; font-size: 11px; }
QLabel#runtimeBadge { background: #17191b; border: 1px solid #3b4245; border-radius: 3px; color: #aeb5b5; padding: 7px 8px; font-size: 11px; }
QFrame#commandHeader { background: #101315; border-bottom: 1px solid #2a3032; }
QLabel#commandModuleTitle { color: #e9ebea; font-size: 22px; font-weight: 700; }
QTabBar#commandSubnav { background: #101315; border-bottom: 1px solid #2a3032; }
QTabBar#commandSubnav::tab { background: #101315; color: #8d989b; padding: 10px 16px; border-bottom: 2px solid transparent; font-size: 12px; }
QTabBar#commandSubnav::tab:selected { color: #e3a252; border-bottom-color: #e3a252; }
QTabBar#commandSubnav QToolButton { background: #1d2123; color: #e3a252; border: 1px solid #343b3e; }

QScrollArea#categoryGrid, QWidget#categoryGridBody { background: #0b0d0f; border: 0; }
QFrame#categoryCard { background: #15191b; border: 1px solid #343b3e; border-top: 2px solid #b87536; border-radius: 7px; }
QFrame#categoryCard:hover, QFrame#categoryCard:focus { background: #1b2022; border-color: #545e61; border-top-color: #e3a252; }
QLabel#cardIcon { color: #e3a252; font-size: 9px; }
QLabel#cardTitle { color: #e7e9e8; font-size: 13px; font-weight: 700; }
QLabel#cardVisibility { color: #899497; font-size: 10px; }
QLabel#cardDescription, QLabel#cardMeta, QLabel#metricCaption { color: #879296; font-size: 10px; }
QLabel#cardValue { color: #e3a252; font-size: 27px; font-weight: 700; }
QLabel#metricValue { color: #dce1df; font-size: 12px; font-weight: 700; }
QFrame#overviewTrend { background: #15191b; border: 1px solid #303739; border-radius: 3px; }
QLabel#commandStatusBar { color: #7f8a8e; background: #0f1214; font-size: 11px; padding: 7px 30px; border-top: 1px solid #252b2d; }

QFrame#devicePoolOverlay { background: transparent; }
QFrame#devicePoolDialog { background: #14191b; border: 1px solid #4c4940; border-radius: 14px; }
QWidget#devicePoolViewport, QWidget#devicePoolWide, QStackedWidget#devicePoolPages, QWidget#poolListViewport { background: #14191b; }
QWidget#poolInfoCell { background: transparent; }
QScrollArea#devicePoolScroll, QWidget#devicePoolBody, QFrame#devicePoolDetails { background: #14191b; border: 0; }
QFrame#poolListPanel { background: transparent; border: 0; }
QFrame#poolInfoCard { background: #1b2022; border: 1px solid #31383a; border-radius: 8px; }
QLabel#poolTitle { color: #f3ecdf; font-size: 19px; font-weight: 600; }
QLabel#poolDeviceName { color: #ece9df; font-size: 17px; font-weight: 600; }
QLabel#poolGroupTitle { color: #deb47b; font-size: 12px; font-weight: 600; }
QLabel#poolCaption { color: #939ea2; font-size: 11px; }
QLabel#poolField { color: #dde2df; font-size: 12px; }
QLabel#poolEmpty { color: #939ea2; background: #191e20; border: 1px dashed #394144; border-radius: 8px; padding: 14px; }
QPushButton#poolClose { color: #a9b2b3; background: transparent; border: 1px solid #394144; border-radius: 8px; padding: 0; font-size: 20px; }
QPushButton#poolClose:hover { color: #f3ecdf; background: #303638; border-color: #9b7850; }
QPushButton#poolStop { color: #efbd84; border-color: #826242; }
QPushButton[poolAction="true"] { color: #dfe3e1; background: #1a2022; border: 1px solid #485452; border-radius: 6px; font-size: 13px; padding: 0 12px; min-height: 34px; max-height: 34px; }
QPushButton[poolAction="true"]:hover, QPushButton[poolAction="true"]:focus { color: #efbd84; background: #30291f; border-color: #b8864e; }
QPushButton[poolAction="true"]:disabled { color: #788286; background: #15191b; border-color: #303739; }
QPushButton#poolMore::menu-indicator { image: none; width: 0; }
QTreeWidget#poolDeviceList { background: transparent; border: 0; padding: 0; outline: 0; }
QTreeWidget, QTextBrowser { background: #15191b; alternate-background-color: #1b2022; border: 1px solid #343b3e; border-radius: 3px; selection-background-color: #57452f; selection-color: #fff4e2; padding: 6px; }
QTreeWidget::item { min-height: 28px; padding: 3px 6px; border-bottom: 1px solid #303739; }
QTreeWidget::item:selected { background: #57452f; color: #fff4e2; }
QTreeWidget::item:hover { background: #262b2d; }
QHeaderView::section { color: #aeb5b5; background: #1a1e20; padding: 8px; border: 0; border-bottom: 1px solid #343b3e; font-size: 11px; }
QTextBrowser { padding: 12px; }
QTableView { background: #15191b; gridline-color: #343b3e; alternate-background-color: #1b2022; }

QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox { background: #171c1e; border: 1px solid #485054; border-radius: 3px; padding: 6px 10px; min-height: 23px; selection-background-color: #685035; }
QComboBox { padding-right: 6px; border-radius: 6px; }
QComboBox:hover { background: #22282a; border-color: #788286; }
QComboBox:disabled { color: #788286; background: #15191b; border-color: #303739; }
QComboBox::drop-down { border: 0; width: 28px; }
QComboBox::down-arrow { image: none; width: 0; height: 0; }
QFrame#workspaceChoicePopup { background: transparent; border: 0; }
QListView#workspaceChoices { background: #1d2325; border: 0; padding: 0; outline: 0; }
QWidget#workspaceChoicesViewport { background: #1d2325; font-size: 13px; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #d99342; }
QCheckBox { spacing: 8px; padding: 5px 0; }
QCheckBox::indicator { width: 15px; height: 15px; background: #171c1e; border: 1px solid #61736a; }
QCheckBox::indicator:checked { background: #d99342; border-color: #d99342; }
QToolTip { color: #f5f5ef; background: #303739; border: 1px solid #879296; padding: 6px; }
QScrollBar:vertical { background: #101315; width: 11px; margin: 0; }
QScrollBar:horizontal { background: #101315; height: 11px; margin: 0; }
QScrollBar::handle { background: #485054; border-radius: 4px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #788286; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QScrollArea { border: 0; }
QSplitter::handle { background: #303739; width: 2px; }

QFrame#operationCard, QFrame#monitorCard { background: #15191b; border: 1px solid #343b3e; border-radius: 5px; }
QLabel#controlTitle { font-size: 15px; font-weight: 600; color: #e7e9e8; }
QLabel#readback, QLabel#mutedText { color: #9dabad; font-size: 12px; }
QLabel#liveValue { font-size: 20px; color: #e3a252; }
QPushButton#cardLink { text-align: left; padding: 4px 0; border: 0; background: transparent; font-weight: 600; }
QTabWidget::pane { border: 1px solid #343b3e; }
QTabBar::tab { background: #1d2325; color: #aeb5b5; padding: 9px 12px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #e3a252; border-bottom-color: #e3a252; }
QLabel#rangeHint { color: #b3c1b9; font-size: 12px; }
QLabel#inputFeedback { color: #e3a252; font-size: 12px; }
QDialog, QMessageBox, QInputDialog, QFileDialog { background: #101315; }
QMenu { background: #1d2325; border: 1px solid #505957; border-radius: 8px; padding: 6px; font-size: 13px; }
QMenu#workspaceActionMenu { background: transparent; border: 0; margin: 8px; }
QMenu::item { height: 18px; padding: 8px 12px; border-radius: 5px; color: #e7e9e8; }
QMenu::item:selected { background: #303638; color: #efbd84; }
QMenu::item:disabled { color: #788286; }
QMenu::separator { height: 1px; background: #394244; margin: 5px 8px; }

/* Signal source: compact instrument panels, using the approved amber palette. */
QFrame#channelPanel { background: #15191b; border: 1px solid #343b3e; border-radius: 5px; }
QLabel#channelTitle { color: #e3a252; background: #1d2123; padding: 9px 12px; font-size: 14px; font-weight: 600; }
QFrame#sourceGroup, QFrame#compactOperation { background: transparent; border: 0; }
QWidget#parameterEditor { background: transparent; }
QWidget#parameterEditor QLineEdit { placeholder-text-color: #879296; }
QFrame#compactOperation QLabel#controlTitle { font-size: 12px; color: #b5bfbd; }
QFrame#compactOperation QLabel#readback { font-size: 11px; color: #91a29c; }
QFrame#compactOperation QLabel#rangeHint { font-size: 11px; }
QFrame#compactOperation QLabel#operationStatus { font-size: 11px; color: #e3a252; }
QFrame#compactOperation QLineEdit#sourceValue { font-size: 16px; font-weight: 400; padding: 3px 9px; min-height: 25px; }
QFrame#compactOperation QLineEdit#sourceValue[emptyInput="true"] { font-size: 13px; }
QFrame#compactOperation QComboBox { padding: 3px 7px; padding-right: 6px; min-height: 25px; }
QLabel#outputState { font-size: 14px; font-weight: 600; color: #e3a252; padding: 3px 5px; }
QFrame#sourceGroup QPushButton#primaryButton:disabled { background: #15191b; color: #788286; border-color: #303739; font-weight: 400; }

/* Electronics: restrained two-column controls and device-wide settings. */
QFrame#channelPanel[simplified="true"] { border-color: #333c3e; border-radius: 10px; }
QFrame#sourceChannelHeader { background: transparent; border: 0; border-bottom: 1px solid #30383a; }
QFrame#sourceChannelHeader QLabel#channelTitle { background: transparent; padding: 0; font-size: 17px; }
QFrame#sourceChannelHeader QWidget { background: transparent; }
QFrame#sourceChannelHeader QLabel#outputState { color: #9ca9a9; font-size: 12px; font-weight: 400; padding: 0; }
QFrame#sourceChannelHeader QLabel#outputState[outputActive="true"] { color: #e3a252; }
QPushButton#sourceOutputButton { border-color: #4d585a; border-radius: 6px; padding: 3px 10px; font-size: 12px; }
QFrame#sourceGroup[simplified="true"] QLineEdit#sourceValue { font-size: 20px; padding: 7px 10px; min-height: 26px; border-radius: 6px; border-color: #414c4e; }
QFrame#sourceGroup[simplified="true"] QLineEdit#sourceValue:focus { border-color: #d99342; }
QFrame#sourceGroup[simplified="true"] QLineEdit#sourceValue[emptyInput="true"] { font-size: 13px; }
QFrame#sourceGroup[simplified="true"] QComboBox { padding: 7px 9px; min-height: 26px; border-color: #414c4e; }
QFrame#sourceGroup[simplified="true"] QComboBox:focus { border-color: #d99342; }
QFrame#sourceGroup[simplified="true"] QLabel#rangeHint { color: #899b9a; font-size: 11px; }
QFrame#sourceGroup[simplified="true"] QLabel#controlTitle { color: #b7c1bf; font-size: 12px; }
QFrame#sourceGroup[simplified="true"] QPushButton#primaryButton { border-radius: 6px; }
QPushButton#sourceSettingsButton { border-radius: 6px; padding: 5px 14px; }
QLabel#sourceConnectionState { color: #9dabad; font-size: 12px; padding: 0 6px; }
QDialog#sourceSettingsDialog { background: #151b1d; border: 1px solid #535b58; border-radius: 12px; }
QLabel#sourceSettingsTitle { font-size: 20px; font-weight: 600; }
QPushButton#sourceSettingsClose { background: transparent; border: 0; padding: 0; min-height: 0; font-size: 22px; color: #9dabad; }
QPushButton#sourceSettingsClose:hover { background: #30383a; color: #f3ecdf; }
QFrame#sourceSettingsSection { background: #1b2224; border: 1px solid #364143; border-radius: 8px; }
QPushButton#referenceChoice { border-radius: 6px; background: #171d1f; border-color: #455153; }
QPushButton#referenceChoice:checked { background: #342b20; border-color: #b7854e; color: #efbd84; }
QPushButton#referenceChoice:disabled { color: #788286; border-color: #303739; }
QPushButton#referenceChoice:focus, QPushButton#sourceSettingsButton:focus, QPushButton#sourceOutputButton:focus,
QDialog#sourceSettingsDialog QPushButton:focus { border: 1px solid #e3a252; }

/* Power supplies: two columns of compact, all-channel cards. */
QFrame#powerChannel { background: #151b1d; border: 1px solid #3b4243; border-top: 2px solid #986b38; border-radius: 8px; }
QFrame#powerChannel QWidget { background: transparent; }
QLabel#powerChannelTitle { color: #e3a252; font-size: 17px; font-weight: 600; }
QLabel#powerSyncState { color: #97a6a5; font-size: 12px; }
QFrame#powerChannel QLineEdit#powerValue { background: #101618; border: 1px solid #485054; font-size: 22px; padding: 4px 8px; min-height: 28px; border-radius: 5px; }
QFrame#powerChannel QLineEdit#powerValue:focus { border-color: #d99342; }
QFrame#powerChannel QComboBox { background: #1b2224; padding: 4px 5px; min-height: 28px; }
QFrame#powerChannel QLabel#powerMeasured { color: #e2c08b; font-size: 12px; }
QFrame#powerChannel QLabel#rangeHint { color: #8da09c; font-size: 11px; }
QFrame#powerChannel QPushButton#primaryButton { background: #d99342; border-color: #d99342; color: #14110d; font-weight: 700; border-radius: 5px; }
QFrame#powerChannel QPushButton#primaryButton:disabled { background: #1a2022; color: #778584; border-color: #354042; font-weight: 400; }
QLabel#powerOutputState { color: #b2bdba; font-size: 12px; }
QPushButton#powerOutputButton { border-color: #a87946; color: #efbd84; border-radius: 5px; padding: 0 8px; min-height: 0; }
QPushButton#powerOutputButton:disabled { color: #788286; border-color: #354042; }
QLabel#poolConnectionError {
    color: #ee9292;
    background-color: #302022;
    border: 1px solid #61373b;
    border-radius: 6px;
    padding: 10px 12px;
}

/* Spectrum: keep plot and compact controls side by side at 100% logical size. */
QFrame#spectrumChart { background: #111719; border: 1px solid #353f40; border-radius: 8px; }
QFrame#spectrumChart QLabel { border: 0; background: transparent; }
/* Reserve the same frame width in every recording state; plots never jump. */
QFrame#spectrumChart[recordingFrame="true"], QFrame#monitorCard[recordingFrame="true"] { border-width: 2px; }
QFrame#spectrumChart[recordingPhase="recording"], QFrame#monitorCard[recordingPhase="recording"],
QFrame#spectrumChart[recordingPhase="draining"], QFrame#monitorCard[recordingPhase="draining"] { border-color: #b96360; }
QToolButton#curveTools, QToolButton#recordButton {
    background: #1a2224; border: 1px solid #455254; border-radius: 6px;
    padding: 2px 8px; font-size: 12px;
}
QToolButton#curveTools:hover, QToolButton#recordButton:hover { background: #293033; border-color: #a87946; }
QToolButton#recordButton[recordingPhase="recording"] { background: #412728; color: #f4d5d1; border-color: #b96360; }
QToolButton#recordButton[recordingPhase="recording"]:hover { background: #553033; border-color: #df8980; }
QToolButton#recordButton:disabled { background: #151b1d; color: #788286; border-color: #354042; }
QToolButton#recordButton[recordingPhase="draining"] { background: #302425; color: #c29d98; border-color: #885854; }
QToolButton#recordButton:focus, QToolButton#curveTools:focus { border-color: #e3a252; }
QLabel#spectrumChartTitle { color: #e2b77e; font-size: 14px; font-weight: 600; }
QLabel#spectrumHealth { color: #b8c5bd; font-size: 12px; padding: 2px 0; }
QFrame#spectrumControls { border: 0; background: transparent; }
QFrame#spectrumControls QScrollArea { border: 0; background: transparent; }
QFrame#spectrumControls QFrame#compactOperation { border: 0; padding: 0; }
QFrame#spectrumControls QLabel#controlTitle { font-size: 12px; color: #b9c2be; }
QFrame#spectrumControls QLineEdit#sourceValue { font-size: 18px; min-height: 26px; padding: 3px 6px; border-radius: 5px; }
QFrame#spectrumControls QComboBox { min-height: 26px; padding: 3px 4px; border-radius: 5px; }
QFrame#spectrumControls QCheckBox { font-size: 11px; spacing: 3px; padding: 0; }
QFrame#spectrumControls QLabel#rangeHint { font-size: 10px; color: #83948e; }
QFrame#spectrumControls QLabel#readback { font-size: 11px; color: #bea681; }
QFrame#spectrumControls QPushButton { padding: 3px 8px; }
QFrame#spectrumControls QPushButton#primaryButton:disabled { background: #1a2022; border-color: #354042; color: #778584; }
QListWidget#spectrumMarkerList { background: #13191b; border: 1px solid #354042; border-radius: 5px; font-size: 11px; }
QListWidget#spectrumMarkerList::item { padding: 5px 7px; border-bottom: 1px solid #293234; }
QListWidget#spectrumMarkerList::item:selected { background: #463722; color: #f2d2a2; }

/* Oscilloscope: small channel cards with physical, release-to-apply sliders. */
QFrame#scopeControls, QFrame#scopeControls QScrollArea { border: 0; background: transparent; }
QToolButton#scopeFineButton { min-width: 52px; min-height: 26px; border: 1px solid #43504f; border-radius: 4px; color: #bcc7c4; background: #1b2325; }
QToolButton#scopeFineButton:checked { color: #f0bc72; background: #433322; border-color: #c28a43; }
QToolButton#scopeFineButton:hover { border-color: #deb273; }
QToolButton#scopeFineButton:disabled { color: #788286; background: #151b1d; border-color: #354042; }
QFrame#scopeSection { background: #1a2224; border: 1px solid #354143; border-radius: 7px; }
QFrame#scopeSection QWidget { background: transparent; }
QFrame#scopeSection QLabel { border: 0; padding: 0; }
QLabel#scopeControlLabel { font-size: 11px; color: #99aaa8; }
QLabel#scopeControlValue { font-size: 12px; color: #e2d9c8; }
QFrame#scopeSection QCheckBox { font-size: 13px; spacing: 7px; padding: 0; }
QFrame#scopeSection QCheckBox::indicator { width: 14px; height: 14px; border-radius: 3px; }
QFrame#scopeControls QSlider::groove:horizontal { height: 3px; background: #3b494c; border-radius: 1px; }
QFrame#scopeControls QSlider::sub-page:horizontal { background: #ac7c43; border-radius: 1px; }
QFrame#scopeControls QSlider::handle:horizontal { width: 12px; margin: -5px 0; border-radius: 6px; background: #deb273; border: 1px solid #edc58e; }
QFrame#scopeControls QSlider::handle:horizontal:disabled { background: #52605d; border-color: #65706a; }
QFrame#scopeControls QSlider::sub-page:horizontal:disabled { background: #52605d; }
QFrame#scopeSection QToolButton { padding: 0 5px; min-height: 22px; font-size: 17px; border: 0; }
