/* Shared hardware / Mock workstation. */
QWidget {
    color: #e2e7e5;
    background-color: #111618;
    font-size: 13px;
}
QWidget#shellRoot, QDialog { background-color: #111618; }
QLabel { background: transparent; }
QLabel#pageTitle { color: #f2f3ed; font-size: 23px; font-weight: 600; }
QPushButton {
    background: #222a2d;
    border: 1px solid #465055;
    border-radius: 5px;
    padding: 5px 12px;
    min-height: 25px;
    color: #e2e7e5;
}
QPushButton:hover { background: #303a3e; border-color: #ad824b; }
QPushButton:pressed { background: #39464b; }
QPushButton:disabled { color: #8c979c; background: #191f22; border-color: #343d41; }
QPushButton#primaryButton { background: #d99342; border-color: #d99342; color: #17130c; }
QPushButton#primaryButton:hover { background: #edac5b; }
QPushButton#primaryButton:disabled { background: #584832; color: #c5b9a8; }
QPushButton#deviceCard {
    text-align: left;
    padding: 10px 14px;
    border: 1px solid #3a4448;
    border-top: 2px solid #81603b;
    background: #1b2225;
}
QPushButton#deviceCard:hover { background: #252e32; border-color: #a87b47; }
QPushButton#deviceCard:checked { background: #342d23; border-color: #e3a252; }
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    background: #1a2226;
    border: 1px solid #465259;
    border-radius: 4px;
    padding: 6px 10px;
    min-height: 23px;
    selection-background-color: #685035;
}
QComboBox { padding-right: 24px; }
QComboBox::drop-down { border-left: 1px solid #465259; width: 20px; }
QComboBox QAbstractItemView {
    background: #202a2f;
    selection-background-color: #675138;
    selection-color: #ffffff;
    border: 1px solid #566167;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #d99342; }
QTreeWidget, QTextBrowser {
    background: #151c1f;
    alternate-background-color: #1b2428;
    border: 1px solid #3b464c;
    border-radius: 4px;
    selection-background-color: #57452f;
    selection-color: #ffffff;
    padding: 6px;
}
QTreeWidget::item { min-height: 34px; padding: 4px 6px; border-bottom: 1px solid #293339; }
QTreeWidget::item:selected { background: #57452f; color: #fff4e2; }
QTreeWidget::item:hover { background: #303c42; }
QHeaderView::section {
    color: #b9c5ca;
    background: #242e33;
    padding: 9px 8px;
    border: 0;
    border-bottom: 1px solid #53616a;
    font-weight: 600;
}
QFrame#deviceDrawer { background: #192125; border: 1px solid #364248; border-radius: 5px; }
QTextBrowser { line-height: 1.5; padding: 12px; }
QSplitter::handle { background: #303c42; width: 2px; }
QCheckBox { spacing: 8px; padding: 5px 0; }
QToolTip { color: #f5f5ef; background: #354148; border: 1px solid #87959d; padding: 6px; }
QScrollBar:vertical { background: #161d21; width: 11px; margin: 0; }
QScrollBar:horizontal { background: #161d21; height: 11px; margin: 0; }
QScrollBar::handle { background: #4b5b63; border-radius: 4px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #74858d; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QFrame#workspaceSidebar { background: #121416; border-right: 1px solid #343b3e; }
QPushButton#workspaceNav { text-align: left; border: 0; padding: 12px 10px; background: transparent; }
QPushButton#workspaceNav:checked { color: #e3a252; background: #282723; border-left: 2px solid #e3a252; }
QFrame#operationCard, QFrame#monitorCard { background: #192125; border: 1px solid #394449; border-radius: 5px; }
QLabel#controlTitle { font-size: 15px; font-weight: 600; color: #eceee9; }
QLabel#readback, QLabel#mutedText { color: #9dabad; font-size: 12px; }
QLabel#liveValue { font-size: 20px; color: #e3b071; }
QPushButton#cardLink { text-align: left; padding: 4px 0; border: 0; background: transparent; font-weight: 600; }
QTabWidget::pane { border: 1px solid #394449; }
QTabBar::tab { background: #20292d; color: #aebabb; padding: 9px 12px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #e3a252; border-bottom-color: #e3a252; }
QScrollArea { border: 0; }
QTableView { background: #151c1f; gridline-color: #3a454b; alternate-background-color: #1b2428; }
